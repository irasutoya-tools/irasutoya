module Irasutoya
  module Modules
    module HasShowPageParser
      extend DualLevel::ClassMethods

      module Methods
        def parse_show_page: (document: untyped, ?url: String?) -> { title: String, description: String, image_urls: Array[String], ?categories: Array[Category] }
      end

      module PrivateMethods
        def self.categories_from: (post: untyped, url: String?) -> Array[Category]
        def self.image_urls_from: (post: untyped, url: String?) -> Array[String]
        private def self.category_from: (String title, String href, String? page_url) -> Category?
        private def self.resolve_image_url: (String source, String? page_url) -> String?
        private def self.one_pixel_blogger_image?: (URI::HTTP url) -> bool
      end
    end
  end
end
