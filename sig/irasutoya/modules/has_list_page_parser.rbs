module Irasutoya
  module Modules
    module HasListPageParser
      def self.included: (Class) -> void

      module Methods
        type list_card = { title: String, show_url: String, thumbnail_url: String? }

        def parse_list_page: (document: untyped) -> Array[list_card]

        def each_list_card: (document: untyped) -> Enumerator[list_card, void]
                          | (document: untyped) { (list_card) -> void } -> void

        private def list_cards_for_enumeration: (document: untyped) -> (Array[list_card] | Enumerator[list_card, void])
      end

      module PrivateMethods
        def self.parse_card: (untyped) -> { title: String, show_url: String, thumbnail_url: String? }?
        def self.thumbnail_url_from: (box: untyped) -> String?
      end
    end
  end
end
