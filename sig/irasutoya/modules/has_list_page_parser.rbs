module Irasutoya
  module Modules
    module HasListPageParser
      def self.included: (Class) -> void

      type card = { title: String, show_url: String, thumbnail_url: String? }

      module Methods
        def parse_list_page: (document: untyped) -> Array[card]
        private def list_page_entries: (document: untyped) -> (Array[card] | Enumerator::Lazy[card, untyped])
        private def list_page_cards: (document: untyped) -> Enumerator::Lazy[card, untyped]
      end

      module PrivateMethods
        def self.parse_card: (box: untyped) -> card?
        def self.thumbnail_url_from: (box: untyped) -> String?
        private def self.card_links: (box: untyped) -> [untyped, untyped]
      end
    end
  end
end
