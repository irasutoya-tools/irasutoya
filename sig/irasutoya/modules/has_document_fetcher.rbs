module Irasutoya
  module Modules
    module HasDocumentFetcher
      FETCH_TIMEOUT: Integer
      MAX_HTML_BYTES: Integer
      REDIRECT_CODES: Array[String]

      def self.included: (Class) -> void

      module Methods
        def fetch_page_and_parse: (String, ?uri: URI::Generic?) -> untyped

        private

        def trusted_page_url?: (URI::Generic) -> bool
        def with_fetch_timeout: [A] () { (Numeric) -> A } -> A
      end

      class HttpDocument
        TRUSTED_HOST: String
        MAX_REDIRECTS: Integer

        def open: [Result] (untyped) { (untyped) -> Result } -> Result
        def trusted_page_url?: (URI::Generic) -> bool

        private

        def fetch_page: [Result] (untyped, Integer) { (untyped) -> Result } -> Result
        def request: (untyped) -> untyped
        def unread_redirect_body?: (untyped) -> bool
        def trusted_page_uri: (untyped) -> untyped
        def redirect: (untyped, untyped, untyped) -> untyped
        def response_document: (untyped, untyped) -> untyped
      end

      HTTP_DOCUMENT: HttpDocument
    end
  end
end
