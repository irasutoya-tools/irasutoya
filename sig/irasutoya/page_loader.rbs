module Irasutoya
  module PageLoader
    def self.load_list: (
      String,
      fetch: ^(String) -> untyped,
      parse: ^(document: untyped) -> Array[{ title: String, show_url: String }]
    ) -> Array[IrasutoLink]

    def self.load_detail: (
      String,
      fetch: ^(String) -> untyped,
      parse: ^(document: untyped) -> { title: String, description: String, image_urls: Array[String] }
    ) -> Irasuto
  end
end
