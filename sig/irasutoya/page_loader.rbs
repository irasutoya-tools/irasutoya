module Irasutoya
  module PageLoader
    type list_entry = { title: String, show_url: String, ?thumbnail_url: String? }
    type list_parser = ^(document: untyped) -> (Array[list_entry] | Enumerator::Lazy[list_entry, untyped])

    def self.load_list: (
      String,
      fetch: ^(String) -> untyped,
      parse: list_parser,
      ?page: Integer
    ) -> Array[IrasutoLink]

    def self.each_list_link: (
      String,
      fetch: ^(String) -> untyped,
      parse: list_parser
    ) { (IrasutoLink) -> void } -> void

    def self.load_detail: (
      String,
      fetch: ^(String) -> untyped,
      parse: Method
    ) -> Irasuto

    def self.effective_url: (untyped, String) -> String

    private def self.parse_detail: (Method, untyped, String) -> { title: String, description: String, image_urls: Array[String], ?categories: Array[Category] }
    private def self.fetch_list_page: (String, Integer, ^(String) -> untyped) -> [untyped, String]?
    private def self.each_page_link: (untyped, String, list_parser) { (IrasutoLink) -> void } -> void
    private def self.each_list_page: (String, ^(String) -> untyped) { (untyped, String) -> void } -> void
    private def self.older_page_url: (untyped, String) -> String?
    private def self.without_fragment: (String) -> String
    private def self.resolve_trusted_href: (String, String) -> String?
  end
end
