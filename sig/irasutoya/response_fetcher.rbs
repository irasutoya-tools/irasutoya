module Irasutoya
  class ResponseTooLargeError < StandardError
  end

  module ResponseFetcher
    REDIRECT_CODES: Array[String]
    MAX_REDIRECTS: Integer

    def self.get: (String, max_bytes: Integer, ?follow_redirects: bool) -> [String, String?]
    private def self.request: (URI::HTTP, Integer, bool) -> ([String, String?] | String)
    private def self.redirect_uri: (URI::HTTP, String) -> URI::HTTP
    def self.read_body: (Net::HTTP, Net::HTTPResponse, Integer) -> String
    private def self.abort_download: (Net::HTTP, Integer) -> bot
  end
end
