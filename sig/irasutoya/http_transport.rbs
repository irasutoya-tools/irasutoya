$ERROR_INFO: Exception?

module Irasutoya
  class FetchDeadlineExceeded < StandardError
  end

  interface _ChunkSocket
    def close: () -> void
  end

  module ChunkedReadDeadline : _ChunkSocket
    def read: (Integer, ?untyped, ?bool) -> untyped
  end

  class ProxyDecisions
    type destination = [String, String, Integer]
    type proxy_settings = Hash[String, String]
    type decision = [proxy_settings, Float, URI::Generic?]

    TTL: Float
    MAX_ENTRIES: Integer
    PROXY_SETTING: Regexp
    @lock: Mutex
    @entries: Hash[destination, decision]

    def resolve: (URI::HTTP) -> URI::Generic?
    def initialize: () -> void

    private

    def remember: (destination, proxy_settings, URI::Generic?) -> void
    def monotonic_time: () -> Float
    def find_proxy: (URI::HTTP, proxy_settings) -> URI::Generic?
  end

  module GzipResponse
    def self.encoded?: (Net::HTTPResponse) -> bool
    def self.read: (Net::HTTPResponse) { (String) -> void } -> void
    private def self.inflate_members: (Zlib::Inflate, String) { (String) -> void } -> void
  end

  type origin = [Integer, String, String, Integer, String?]

  class SessionWaiters
    type queue = Hash[ConditionVariable, true]

    @queues: Hash[origin, queue]

    def initialize: () -> void
    def wait: (origin, Mutex) -> void
    def notify: (origin) -> void

    private

    def wait_interruptibly: (ConditionVariable, Mutex) -> void
    def finish_wait: (origin, queue, ConditionVariable, true?) -> void
  end

  class HttpSessionPool
    MAX_CONNECTIONS_PER_ORIGIN: Integer
    @max_connections: Integer
    @lock: Mutex
    @waiters: SessionWaiters
    @sessions: Hash[origin, Hash[HttpSession, bool]]
    @proxy_decisions: ProxyDecisions

    def request: (URI::HTTP) { (Net::HTTP, Net::HTTPResponse) -> untyped } -> Net::HTTPResponse
    def read_body: (Net::HTTP, Net::HTTPResponse, Integer) -> String
    def initialize: (?max_connections: Integer) -> void
    def close_inherited_connections: () -> void

    private

    def read_response_body: (Net::HTTPResponse, String) { (String) -> void } -> void
    def abort_download: (Net::HTTP, Integer) -> bot
    def with_session: [Result] (origin) { (HttpSession) -> Result } -> Result
    def acquire_session: (origin) -> HttpSession
    def idle_session: (Hash[HttpSession, bool]) -> HttpSession?
    def new_session: (origin) -> HttpSession
    def release_session: (origin, HttpSession) -> void
    def remove_idle_session: (origin, HttpSession) -> bool
  end

  class HttpSession
    IDLE_TIMEOUT: Float
    @lock: Mutex
    @on_idle: ^(HttpSession) -> bool
    @http: untyped
    @idle_since: Float

    def reusable_connection?: () -> bool
    def request: (URI::HTTP, URI::Generic?) { (Net::HTTP, Net::HTTPResponse) -> untyped } -> Net::HTTPResponse
    def initialize: () { (HttpSession) -> bool } -> void
    def close_inherited_connection: () -> void

    private

    def session_for: (untyped, untyped) -> untyped
    def build_http: (untyped, untyped) -> Net::HTTP
    def close_when_idle: () -> void
    def remaining_idle_time: () -> Float
    def monotonic_time: () -> Float
  end

  HTTP_TRANSPORT: HttpSessionPool

  module ForkCleanup
    def _fork: () -> Integer
  end
end
