module Irasutoya
  class Irasuto
    MAX_FEED_BYTES: Integer
    MAX_IMAGE_BYTES: Integer
    FEED_COUNT_TTL: Integer
    FEED_COUNT_CACHE: FeedCountCache

    include Modules::HasDocumentFetcher::Methods
    include Modules::HasListPageParser::Methods
    include Modules::HasShowPageParser::Methods
    extend Modules::HasDocumentFetcher::Methods
    extend Modules::HasListPageParser::Methods
    extend Modules::HasShowPageParser::Methods

    attr_reader url: String
    attr_reader title: String
    attr_reader description: String

    @image_urls: Array[String]
    @categories: Array[Category]

    def image_urls: -> Array[String]
    def categories: -> Array[Category]
    def image_url: -> String?
    def postthumb_image_url: -> String?
    def has_multiple_images: -> bool
    def download_image: (String path, ?index: Integer) -> Integer

    def initialize: (url: String, title: String, description: String, image_urls: Array[String], ?categories: Array[Category]) -> void
    def self.from_url: (String url) -> Irasuto
    def self.random: -> Irasuto
    def self.search: (query: String, ?page: Integer) -> Array[IrasutoLink]
    def self.each_search_result: (query: String) -> Enumerator[IrasutoLink, void]
                               | (query: String) { (IrasutoLink) -> void } -> void
    private def self.search_url: (String) -> String
    private def self.validate_input_url: (String) -> void
    private def self.fetch_feed: (Integer) -> Hash[String, untyped]
    private def self.load_initial_random_post: (String?) -> Irasuto?
    private def self.load_refreshed_random_post: (Integer) -> Irasuto
    private def self.load_detail: (String) -> Irasuto
    private def self.alternate_url: (Hash[String, untyped]?) -> String?
    private def self.trusted_feed_url?: (untyped) -> bool
    private def self.random_entry: (?stale_count: Integer?) -> [Hash[String, untyped]?, Integer]
    private def self.fetch_feed_count: -> [Integer, Hash[String, untyped]]
  end
end
